{
  "name": "monaai",
  "version": "1.0.0",
  "description": "MonaAI - Blockchain-based AI Model Platform",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo": "hardhat run scripts/demo.js --network localhost",
    "verify": "hardhat verify",
    "node": "hardhat node",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run node\" \"npm run backend\" \"npm run frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "clean": "hardhat clean && rm -rf cache artifacts",
    "check": "./scripts/check-system.sh",
    "format": "prettier --write \"**/*.{js,jsx,json,md,sol}\"",
    "lint": "eslint \"**/*.{js,jsx}\"",
    "lint:sol": "solhint \"contracts/**/*.sol\""
  },
  "keywords": [
    "blockchain",
    "AI",
    "machine-learning",
    "ethereum",
    "smart-contracts",
    "IPFS"
  ],
  "author": "MonaAI Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0"
  }
}
